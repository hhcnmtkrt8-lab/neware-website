# Database
DATABASE_URL=./neware.db

# Admin Setup — REQUIRED: change these before first deployment
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=<CHANGE_THIS_STRONG_PASSWORD>

# Session Secret — REQUIRED: generate a long random string (32+ chars)
SESSION_SECRET=<GENERATE_A_RANDOM_SECRET_HERE>

# Site URL — change for production
SITE_URL=https://your-domain.com
